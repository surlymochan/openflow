diff -ruN -x '*.fixed.js' -x '*.fixed.py' tmp/patchgen/semver-compare-orig/src/semver.js tmp/patchgen/semver-compare/src/semver.js
--- a/src/semver.js	2026-10-17 19:55:31.375313735 +0800
+++ b/src/semver.js	2026-10-17 19:56:17.479313735 +0800
@@ -2,21 +2,51 @@
  * Compare two semantic versions.
  * Returns -1, 0 or 1.
  */
-const CORE = /^(\d+)\.(\d+)\.(\d+)$/;
+const SEMVER =
+  /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/;
 
 function parse(value) {
-  const match = CORE.exec(value);
+  if (typeof value !== "string") throw new Error("invalid semver");
+  const match = SEMVER.exec(value);
   if (!match) throw new Error("invalid semver");
   return {
     major: Number(match[1]),
     minor: Number(match[2]),
     patch: Number(match[3]),
+    pre: match[4] ? match[4].split(".") : [],
   };
 }
 
+function compareId(left, right) {
+  const leftNum = /^[0-9]+$/.test(left);
+  const rightNum = /^[0-9]+$/.test(right);
+  if (leftNum && rightNum) {
+    const a = Number(left);
+    const b = Number(right);
+    if (a !== b) return a < b ? -1 : 1;
+    return 0;
+  }
+  if (leftNum && !rightNum) return -1;
+  if (!leftNum && rightNum) return 1;
+  if (left !== right) return left < right ? -1 : 1;
+  return 0;
+}
+
 export function compareSemver(left, right) {
   const a = parse(left);
   const b = parse(right);
-  if (a.major !== b.major) return a.major < b.major ? -1 : 1;
+  for (const key of ["major", "minor", "patch"]) {
+    if (a[key] !== b[key]) return a[key] < b[key] ? -1 : 1;
+  }
+  if (a.pre.length === 0 && b.pre.length === 0) return 0;
+  if (a.pre.length === 0) return 1;
+  if (b.pre.length === 0) return -1;
+  const count = Math.max(a.pre.length, b.pre.length);
+  for (let i = 0; i < count; i += 1) {
+    if (i >= a.pre.length) return -1;
+    if (i >= b.pre.length) return 1;
+    const cmp = compareId(a.pre[i], b.pre[i]);
+    if (cmp !== 0) return cmp;
+  }
   return 0;
 }
